@@ -0,0 +1,22 @@
+package com.wolfgrid.android.features.map.session
+
+import kotlinx.coroutines.CompletableDeferred
+
+/** Status writes must follow the durable create operation for the same UUID. */
+internal class ManualPinSaveGate {
+    class Ticket(val id: String, val ready: CompletableDeferred<Boolean> = CompletableDeferred())
+    private val pending = mutableMapOf<String, Ticket>()
+
+    fun begin(id: String): Ticket {
+        pending.remove(id)?.ready?.complete(false)
+        return Ticket(id).also { pending[id] = it }
+    }
+
+    fun finish(ticket: Ticket, success: Boolean) {
+        if (pending[ticket.id] !== ticket) return
+        ticket.ready.complete(success)
+        if (success) pending.remove(ticket.id)
+    }
+
+    suspend fun await(id: String): Boolean = pending[id]?.ready?.await() ?: true
+}

+package com.wolfgrid.android.features.map
+
+import android.util.Log
+import com.wolfgrid.android.BuildConfig
+
+/** Debug-only timings contain counts and durations, never address/location data. */
+internal object Map2DPerformance {
+    fun record(event: String, startedAtNanos: Long, detail: String = "") {
+        if (BuildConfig.DEBUG) {
+            val elapsedMs = (System.nanoTime() - startedAtNanos) / 1_000_000.0
+            Log.d("Map2DPerformance", "$event durationMs=$elapsedMs $detail")
+        }
+    }
+}

@@ -0,0 +1,73 @@
+package com.wolfgrid.android.features.map
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class CampaignPinLayoutTest {
+    private val points = (0 until 1000).map { CampaignPinGeometry("home-$it", 43.65 + it * 0.00001, -79.38) }
+
+    @Test fun unchangedAndFractionalZoomReuseTheSameLayout() {
+        val cache = CampaignPinLayout()
+        val first = cache.update(points, 15.1f)
+        repeat(100) { assertSame(first, cache.update(points.toList(), 15.9f)) }
+        assertEquals(1, cache.rebuildCount)
+    }
+
+    @Test fun cameraGestureDefersAllRebuildsUntilIdle() {
+        val cache = CampaignPinLayout()
+        val first = cache.update(points, 10f)
+        repeat(120) { assertSame(first, cache.update(points, 10f + it / 15f, isMoving = true)) }
+        assertEquals(1, cache.rebuildCount)
+        assertEquals(1000, cache.update(points, 18f).size)
+        assertEquals(2, cache.rebuildCount)
+    }
+
+    @Test fun reorderingDoesNotChangeMembershipOrRebuild() {
+        val cache = CampaignPinLayout()
+        val first = cache.update(points, 12f)
+        assertSame(first, cache.update(points.reversed(), 12f))
+        assertEquals(1, cache.rebuildCount)
+    }
+
+    @Test fun everyValidPinAppearsExactlyOnceAtEveryZoom() {
+        val cache = CampaignPinLayout()
+        (0..20).forEach { zoom ->
+            val ids = cache.update(points, zoom.toFloat()).flatMap { it.ids }
+            assertEquals(points.map { it.id }.toSet(), ids.toSet())
+            assertEquals(points.size, ids.size)
+        }
+    }
+
+    @Test fun movingAddingAndRemovingPinsInvalidateGeometry() {
+        val cache = CampaignPinLayout()
+        cache.update(points, 14f)
+        cache.update(points.drop(1), 14f)
+        cache.update(points.drop(1) + CampaignPinGeometry("new", 44.0, -79.0), 14f)
+        cache.update(points.map { if (it.id == "home-5") it.copy(longitude = -80.0) else it }, 14f)
+        assertEquals(4, cache.rebuildCount)
+    }
+
+    @Test fun invalidZoomAndCoordinatesRemainBounded() {
+        val cache = CampaignPinLayout()
+        val invalid = listOf(CampaignPinGeometry("nan", Double.NaN, 0.0), CampaignPinGeometry("outside", 91.0, 0.0))
+        val poles = listOf(CampaignPinGeometry("north", 90.0, 180.0), CampaignPinGeometry("south", -90.0, -180.0))
+        assertEquals(setOf("north", "south"), cache.update(invalid + poles, Float.NaN).flatMap { it.ids }.toSet())
+        assertEquals(2, cache.update(poles, Float.POSITIVE_INFINITY).sumOf { it.ids.size })
+    }
+
+    @Test fun tenThousandPinsReuseLayoutDuringStatusOnlyUpdates() {
+        data class Home(val geometry: CampaignPinGeometry, val status: String)
+        val homes = (0 until 10000).map { Home(CampaignPinGeometry("$it", 43.0 + it % 100 * 0.0001, -79.0 + it / 100 * 0.0001), "untouched") }
+        val cache = CampaignPinLayout()
+        val started = System.nanoTime()
+        cache.update(homes.map { it.geometry }, 15f)
+        val firstMs = (System.nanoTime() - started) / 1_000_000.0
+        val updatesStarted = System.nanoTime()
+        repeat(100) { index ->
+            val updated = homes.mapIndexed { i, home -> if (i == index) home.copy(status = "talked") else home }
+            cache.update(updated.map { it.geometry }, 15f)
+        }
+        println("10k pins: firstMs=$firstMs statusUpdates100Ms=${(System.nanoTime() - updatesStarted) / 1_000_000.0} rebuilds=${cache.rebuildCount}")
+        assertEquals(1, cache.rebuildCount)
+    }
+}

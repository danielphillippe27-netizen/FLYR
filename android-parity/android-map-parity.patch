@@ -0,0 +1,55 @@
+package com.wolfgrid.android.features.map
+
+import kotlin.math.floor
+import kotlin.math.ln
+import kotlin.math.pow
+import kotlin.math.sin
+
+internal data class CampaignPinGeometry(val id: String, val latitude: Double, val longitude: Double)
+internal data class CampaignPinCell(val zoom: Int, val x: Long, val y: Long)
+internal data class CampaignPinGroup(val key: String, val ids: List<String>)
+
+/** Geometry only: status, labels, selection and fractional zoom never invalidate membership. */
+internal class CampaignPinLayout {
+    private var previousPoints: Map<String, CampaignPinGeometry>? = null
+    private var previousZoom: Int? = null
+    private var groups = emptyList<CampaignPinGroup>()
+    var rebuildCount = 0
+        private set
+
+    fun update(points: List<CampaignPinGeometry>, zoom: Float, isMoving: Boolean = false): List<CampaignPinGroup> {
+        if (isMoving) return groups
+        val bucket = if (zoom.isFinite()) floor(zoom.toDouble()).toInt().coerceIn(0, 18) else 0
+        val valid = points.asSequence().filter {
+            it.latitude.isFinite() && it.longitude.isFinite() &&
+                it.latitude in -90.0..90.0 && it.longitude in -180.0..180.0
+        }.associateBy { it.id }
+        if (previousZoom == bucket && previousPoints == valid) return groups
+        previousZoom = bucket
+        previousPoints = valid
+        rebuildCount++
+        groups = if (bucket >= 18) {
+            valid.values.map { CampaignPinGroup("pin:${it.id}", listOf(it.id)) }
+        } else {
+            val scale = 256 * 2.0.pow(bucket)
+            valid.values.groupBy { point ->
+                val sine = sin(Math.toRadians(point.latitude.coerceIn(-85.05112878, 85.05112878)))
+                val x = (point.longitude + 180) / 360 * scale
+                val y = (0.5 - ln((1 + sine) / (1 - sine)) / (4 * Math.PI)) * scale
+                CampaignPinCell(bucket, floor(x / 64).toLong(), floor(y / 64).toLong())
+            }.map { (cell, members) ->
+                CampaignPinGroup("cell:${cell.zoom}:${cell.x}:${cell.y}", members.map { it.id })
+            }
+        }
+        return groups
+    }
+}
+
+/** Retains current item data while reusing the shared layout algorithm. */
+internal fun <T> campaignPinGroups(items: List<T>, zoom: Float, coordinate: (T) -> Pair<Double, Double>): List<List<T>> {
+    val points = items.mapIndexed { index, item ->
+        val (lat, lon) = coordinate(item)
+        CampaignPinGeometry(index.toString(), lat, lon)
+    }
+    return CampaignPinLayout().update(points, zoom).map { group -> group.ids.map { items[it.toInt()] } }
+}

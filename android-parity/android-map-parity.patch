+package com.wolfgrid.android.features.map
+
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.ui.geometry.Offset
+import androidx.compose.ui.test.junit4.createComposeRule
+import androidx.compose.ui.test.onNodeWithContentDescription
+import androidx.compose.ui.test.onNodeWithText
+import androidx.compose.ui.test.performClick
+import androidx.compose.ui.test.performTouchInput
+import androidx.compose.ui.test.swipe
+import com.wolfgrid.android.features.map.session.ManualPinQuickStatusMenu
+import org.junit.Assert.*
+import org.junit.Rule
+import org.junit.Test
+
+class Map2DControlsTest {
+    @get:Rule val compose = createComposeRule()
+
+    @Test fun statusMenuOffersEveryActionWithoutWaitingForAddressLoading() {
+        val selected = mutableListOf<String>()
+        compose.setContent {
+            MaterialTheme {
+                ManualPinQuickStatusMenu(
+                    darkMode = false, addressText = "Pinned Home",
+                    onStatus = { selected += it }, onDismiss = {}, onEdit = {}
+                )
+            }
+        }
+        listOf("No Answer" to "no_answer", "Talked" to "talked", "Lead" to "hot_lead",
+            "Follow Up" to "future_seller", "Appointment" to "appointment").forEach { (label, status) ->
+            compose.onNodeWithText(label).performClick()
+            compose.runOnIdle { assertEquals(status, selected.last()) }
+        }
+        compose.runOnIdle { assertEquals(5, selected.size) }
+    }
+
+    @Test fun twoRingCameraControlRetainsItsDragGesture() {
+        val drags = mutableListOf<Offset>()
+        compose.setContent {
+            MaterialTheme { WolfGridMapPitchBearingControl(onCameraDrag = { drags += it }) }
+        }
+        compose.onNodeWithContentDescription("Drag to rotate or tilt map").performTouchInput {
+            swipe(center, center + Offset(40f, 20f), 300)
+        }
+        compose.runOnIdle { assertTrue(drags.isNotEmpty()) }
+    }
+}

+package com.wolfgrid.android.features.map.session
+
+import kotlinx.coroutines.CoroutineStart
+import kotlinx.coroutines.async
+import kotlinx.coroutines.runBlocking
+import org.junit.Assert.*
+import org.junit.Test
+
+class ManualPinSaveGateTest {
+    @Test fun everyQuickStatusWaitsForItsOwnDurableCreate() = runBlocking {
+        listOf("no_answer", "talked", "hot_lead", "future_seller", "appointment").forEach { status ->
+            val gate = ManualPinSaveGate()
+            val ticket = gate.begin(status)
+            val write = async(start = CoroutineStart.UNDISPATCHED) { gate.await(status) }
+            assertFalse(write.isCompleted)
+            gate.finish(ticket, true)
+            assertTrue(write.await())
+        }
+    }
+
+    @Test fun saveFailureNeverReleasesAnOrphanStatus() = runBlocking {
+        val gate = ManualPinSaveGate()
+        val ticket = gate.begin("pin")
+        gate.finish(ticket, false)
+        assertFalse(gate.await("pin"))
+    }
+
+    @Test fun staleSaveCannotReleaseAReplacementDraft() = runBlocking {
+        val gate = ManualPinSaveGate()
+        val first = gate.begin("pin")
+        val replacement = gate.begin("pin")
+        gate.finish(first, true)
+        assertFalse(first.ready.await())
+        assertFalse(replacement.ready.isCompleted)
+        gate.finish(replacement, true)
+        assertTrue(gate.await("pin"))
+    }
+
+    @Test fun existingAndDifferentPinsAreIndependent() = runBlocking {
+        val gate = ManualPinSaveGate()
+        val pending = gate.begin("pending")
+        assertTrue(gate.await("existing"))
+        assertFalse(pending.ready.isCompleted)
+        gate.finish(pending, true)
+        assertTrue(gate.await("pending"))
+    }
+}

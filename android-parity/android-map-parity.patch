+package com.wolfgrid.android.features.campaign
+
+import com.wolfgrid.android.features.map.session.RouteStop
+import org.junit.Assert.*
+import org.junit.Test
+
+class CampaignManualPinTargetsTest {
+    private fun stop(id: String, manual: Boolean = true) = RouteStop(
+        id = id, label = "Pinned Home", latitude = 43.65, longitude = -79.38, isManualPin = manual
+    )
+
+    @Test fun onlyUserCreatedPinsJoinBuildingsIn3D() {
+        val manual = stop("manual")
+        val address = stop("address", false)
+        val targets = listOf(manual, address).map { it.toCampaignMapTargetRenderItem() }
+        assertFalse(targets.last().isManualPin)
+        assertEquals(listOf("manual"), campaignManualPinTargets(targets, emptyList(), listOf(address)).map { it.id })
+    }
+
+    @Test fun unsyncedSessionAndDroppedPinsSurviveRendererSwitch() {
+        val pins = campaignManualPinTargets(emptyList(), listOf(stop("dropped")), listOf(stop("session"), stop("regular", false)))
+        assertEquals(setOf("dropped", "session"), pins.map { it.id }.toSet())
+    }
+
+    @Test fun allStatusesAndCoordinatesSurviveWithoutDuplicatePins() {
+        listOf("no_answer", "talked", "hot_lead", "future_seller", "appointment").forEach { status ->
+            val stale = stop("PIN")
+            val latest = stop("pin").copy(latitude = 44.0, status = status)
+            val pins = campaignManualPinTargets(listOf(stale.toCampaignMapTargetRenderItem()), listOf(stale), listOf(latest))
+            assertEquals(1, pins.size)
+            assertEquals(44.0, pins.single().point.latitude(), 0.0)
+            assertEquals(status, pins.single().status)
+        }
+    }
+
+    @Test fun everyManualPinRemainsVisibleBeyond120Pins() {
+        val pins = (0 until 250).map { stop("pin-$it") }
+        assertEquals(250, campaignManualPinTargets(emptyList(), emptyList(), pins).size)
+    }
+}

+package com.wolfgrid.android.features.campaign
+
+import com.wolfgrid.android.features.map.session.RouteStop
+import java.util.Locale
+
+/** Session pins are available immediately, before campaign-bundle enrichment or reload. */
+internal fun campaignManualPinTargets(
+    targets: List<CampaignMapTargetRenderItem>,
+    dropped: List<RouteStop>,
+    session: List<RouteStop>
+): List<CampaignMapTargetRenderItem> = (
+    session.filter(RouteStop::isManualPin).map(RouteStop::toCampaignMapTargetRenderItem) +
+        dropped.filter(RouteStop::isManualPin).map(RouteStop::toCampaignMapTargetRenderItem) +
+        targets.filter(CampaignMapTargetRenderItem::isManualPin)
+    ).distinctBy { it.id.lowercase(Locale.US) }

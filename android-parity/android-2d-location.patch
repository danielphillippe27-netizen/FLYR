+
+/** Flat blue location dot and live compass cone; the wolf remains on the 3D map. */
+@Composable
+@GoogleMapComposable
+internal fun GoogleMapUserLocation(location: SessionCoordinate) {
+    val context = LocalContext.current
+    val view = LocalView.current
+    val lifecycle = LocalLifecycleOwner.current.lifecycle
+    val density = LocalDensity.current.density
+    val compass = remember(context, view) {
+        WolfCompassHeading(context) { view.display?.rotation ?: Surface.ROTATION_0 }
+    }
+    val courseEngine = remember { AndroidHeadingPresentationEngine() }
+    val course = remember(location) { courseEngine.nextState(location) }
+    var heading by remember { mutableStateOf<Double?>(null) }
+    DisposableEffect(compass, lifecycle) {
+        val observer = LifecycleEventObserver { _, _ ->
+            compass.setActive(lifecycle.currentState.isAtLeast(Lifecycle.State.STARTED))
+        }
+        lifecycle.addObserver(observer)
+        compass.setActive(lifecycle.currentState.isAtLeast(Lifecycle.State.STARTED))
+        onDispose {
+            lifecycle.removeObserver(observer)
+            compass.setActive(false)
+        }
+    }
+    LaunchedEffect(compass, lifecycle, location) {
+        lifecycle.repeatOnLifecycle(Lifecycle.State.STARTED) {
+            while (isActive) {
+                heading = compass.heading(location) ?: course.headingDegrees.takeIf { course.isRenderable }
+                delay(80)
+            }
+        }
+    }
+    val position = LatLng(location.latitude, location.longitude)
+    val dotIcon = remember(density) {
+        val side = (22 * density).toInt().coerceAtLeast(1)
+        val bitmap = Bitmap.createBitmap(side, side, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bitmap)
+        val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+        paint.color = Color.WHITE
+        canvas.drawCircle(side / 2f, side / 2f, 9 * density, paint)
+        paint.color = Color.rgb(0, 122, 255)
+        canvas.drawCircle(side / 2f, side / 2f, 6 * density, paint)
+        BitmapDescriptorFactory.fromBitmap(bitmap)
+    }
+    val directionIcon = remember(density) {
+        val side = (72 * density).toInt().coerceAtLeast(1)
+        val bitmap = Bitmap.createBitmap(side, side, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bitmap)
+        val center = side / 2f
+        val radius = 34 * density
+        val cone = Path().apply {
+            moveTo(center, center)
+            arcTo(RectF(center - radius, center - radius, center + radius, center + radius), -120f, 60f)
+            close()
+        }
+        val paint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            shader = RadialGradient(center, center, radius,
+                Color.argb(128, 0, 122, 255), Color.argb(5, 0, 122, 255), Shader.TileMode.CLAMP)
+        }
+        canvas.drawPath(cone, paint)
+        BitmapDescriptorFactory.fromBitmap(bitmap)
+    }
+    location.accuracyMeters?.takeIf { it.isFinite() && it > 0 }?.let { accuracy ->
+        Circle(center = position, radius = accuracy.toDouble(),
+            fillColor = androidx.compose.ui.graphics.Color(0x1A007AFF),
+            strokeColor = androidx.compose.ui.graphics.Color(0x2E007AFF), strokeWidth = 1f)
+    }
+    heading?.takeIf { it.isFinite() }?.let { direction ->
+        Marker(state = rememberMarkerState(position = position).apply { this.position = position },
+            contentDescription = "Direction you are facing", anchor = Offset(0.5f, 0.5f),
+            flat = true, rotation = (((direction % 360) + 360) % 360).toFloat(),
+            icon = directionIcon, zIndex = 1000f, onClick = { true })
+    }
+    Marker(state = rememberMarkerState(position = position).apply { this.position = position },
+        contentDescription = "Your location", anchor = Offset(0.5f, 0.5f),
+        icon = dotIcon, zIndex = 1001f, onClick = { true })
+}

// FLYR iOS staging build settings.
// Use this as the base configuration for a Debug-Staging/TestFlight internal scheme.

SUPABASE_URL = https://YOUR-STAGING-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR_STAGING_SUPABASE_ANON_KEY
FLYR_PRO_API_URL = https://staging.flyrpro.app
FLYR_API_BASE_URL = https://staging.flyrpro.app
FLYR_INVITES_API_URL = https://staging.flyrpro.app
FLYR_PASSWORD_RECOVERY_PRODUCTION_URL = https://staging.flyrpro.app/password/reset
FLYR_PASSWORD_RECOVERY_REDIRECT_URL = https://staging.flyrpro.app/password/reset
APS_ENVIRONMENT = development

// Keep real staging secrets local/CI-only.
#include? "Config.staging.local.xcconfig"
